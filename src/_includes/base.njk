<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script>try{if(sessionStorage.getItem('desktop')==='1'){document.querySelector('meta[name="viewport"]').setAttribute('content','width=1200');document.documentElement.classList.add('force-desktop')}}catch(e){}</script>
  <title>{% if title %}{{ title }} · {{ site.nome }}, Psicóloga{% else %}{{ site.nome }} · Psicóloga em Maringá (PR) e Online, Terapia Cognitivo-Comportamental{% endif %}</title>
  <meta name="description" content="{{ description or resumo or site.descricao }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Karla:wght@400;700&display=swap">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:title" content="{{ title or (site.nome + ' · Psicóloga') }}">
  <meta property="og:description" content="{{ description or resumo or site.descricao }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.nome }}, Psicóloga">
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:image" content="{{ site.url }}/images/bruna-retrato.jpg">
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Psychologist",
    "name": site.nomeCompleto,
    "alternateName": "Psi. " + site.nome,
    "description": site.descricao,
    "url": site.url,
    "telephone": "+" + site.whatsapp,
    "image": site.url + "/images/bruna-retrato.jpg",
    "sameAs": [site.instagram],
    "areaServed": ["BR", "PT", "Worldwide"],
    "availableLanguage": ["pt-BR", "pt-PT"],
    "knowsLanguage": "pt-BR",
    "address": { "@type": "PostalAddress", "addressLocality": site.cidade or undefined, "addressRegion": "PR", "addressCountry": "BR" },
    "hasCredential": { "@type": "EducationalOccupationalCredential", "credentialCategory": "Registro profissional", "name": site.crp, "recognizedBy": { "@type": "Organization", "name": "Conselho Regional de Psicologia da 8ª Região (Paraná)" } }
  } | dump | safe }}</script>
  {%- if page.url == "/terapia/" %}
  {%- set qa = [] %}{% for q in faq.perguntas %}{% set qa = (qa.push({ "@type": "Question", "name": q.pergunta, "acceptedAnswer": { "@type": "Answer", "text": q.resposta } }), qa) %}{% endfor %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": qa } | dump | safe }}</script>
  {%- endif %}
  {%- if categoria and resumo %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BlogPosting", "headline": title, "description": resumo, "inLanguage": "pt-BR", "url": site.url + page.url, "author": { "@type": "Person", "name": site.nomeCompleto, "jobTitle": "Psicóloga" }, "publisher": { "@type": "Person", "name": site.nomeCompleto } } | dump | safe }}</script>
  {%- endif %}
</head>
<body>
<a class="hp" href="#main">Pular para o conteúdo</a>
<header class="site-header"><div class="wrap">
  <a class="brand notranslate" href="/">{% include "marca.njk" %}<span class="brand-text"><strong>{{ site.nome }}</strong><small>PSICÓLOGA · {{ site.crp }}</small></span></a>
  <div class="lang-switch notranslate" role="group" aria-label="Idioma"><button type="button" data-lang="pt" lang="pt" title="Português">PT</button><button type="button" data-lang="en" lang="en" title="English">EN</button></div>
  <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav class="nav" id="nav" aria-label="Principal">
    {%- for item in [["/", "Início"], ["/sobre/", "Sobre mim"], ["/terapia/", "Terapia"], ["/reflexoes/", "Reflexões"], ["/contato/", "Contato"]] %}
    <a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] != "/" and page.url.startsWith(item[0])) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
    {%- endfor %}
    <a class="btn" href="{{ links.agendar }}" target="_blank" rel="noopener">Agendar</a>
  </nav>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer"><div class="wrap">
  <div class="foot-top">
    <div class="foot-brand notranslate">{% include "marca.njk" %}<div><strong>{{ site.nome }}</strong><span>Psicóloga · {{ site.crp }}</span></div></div>
    <p class="foot-quote">Você não precisa atravessar isso sozinha.</p>
    <a class="btn" href="{{ links.agendar }}" target="_blank" rel="noopener">Agendar pelo WhatsApp</a>
  </div>
  <div class="foot-cols">
    <div>
      <h4>Atendimento</h4>
      <p class="foot-name-line">Psi. {{ site.nomeCompleto }}</p>
      <p>Psicoterapia online para adultos.</p>
      <p>Terapia Cognitivo-Comportamental.</p>
      {% if site.cidade %}<p>{{ site.cidade }}, Paraná.</p>{% endif %}
    </div>
    <div>
      <h4>Páginas</h4>
      <a href="/">Início</a><a href="/sobre/">Sobre mim</a><a href="/terapia/">Terapia</a><a href="/reflexoes/">Reflexões</a><a href="/contato/">Contato</a>
    </div>
    <div>
      <h4>Contato</h4>
      <a href="{{ links.whatsapp }}" target="_blank" rel="noopener">WhatsApp {{ site.telefone }}</a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram @{{ site.instagramHandle }}</a>
      <a href="/contato/#formulario">Enviar um e-mail</a>
    </div>
  </div>
  <div class="foot-legal">
    <span>© <span data-year>2026</span> {{ site.nomeCompleto }} · {{ site.crp }}</span>
    <span>Em situação de crise, ligue 188 (CVV) ou 192 (SAMU).</span>
    <span class="foot-credit">Site por <a href="https://lickitysplitweb.com" rel="noopener" target="_blank">Lickity Split Web Design</a></span>
    <span class="foot-lang"><div class="lang-switch lang-switch--foot notranslate" role="group" aria-label="Idioma"><button type="button" data-lang="pt" lang="pt" title="Português">PT</button><button type="button" data-lang="en" lang="en" title="English">EN</button></div></span>
    <button class="desktop-toggle" type="button">Ver versão desktop</button>
  </div>
</div></footer>
<div class="wa-bar"><a class="btn" href="{{ links.agendar }}" target="_blank" rel="noopener">Agendar pelo WhatsApp</a></div>
<div id="gt-el" hidden></div>
<script src="/js/site.js?v={{ buildId }}"></script>
<script src="/js/translate.js?v={{ buildId }}" defer></script>
<!-- Cloudflare Web Analytics: cookie-free visit counts -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "e77d2c831cda4cb7821adb8c5bf53267"}'></script>
</body>
</html>
