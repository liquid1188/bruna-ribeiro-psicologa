---
layout: base.njk
---
{%- set wa = "https://wa.me/" + site.whatsapp -%}
<section class="hero"><div class="wrap">
  <div class="hero-text">
    <p class="ruled left">{{ inicio.heroKicker }}</p>
    <h1>{{ inicio.heroTitulo }}</h1>
    <p class="lead">{{ inicio.heroTexto }}</p>
    <div class="cta-row">
      <a class="btn" href="{{ wa }}" target="_blank" rel="noopener">Agendar pelo WhatsApp</a>
      <a class="btn ghost" href="/terapia/">Como funciona <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </div>
  <figure class="hero-portrait">
    <img src="/images/bruna-retrato.jpg" width="1040" height="1040" alt="Bruna Ribeiro, psicóloga, sorrindo, de blusa branca e óculos, diante de um painel de madeira com uma planta ao lado" fetchpriority="high">
    <figcaption>Psi. {{ site.nome }} · <strong>{{ site.crp }}</strong></figcaption>
  </figure>
</div></section>

<section class="paper"><div class="wrap">
  <div class="stack">
    <p class="ruled left">Talvez você se reconheça</p>
    <h2>{{ inicio.sinaisTitulo }}</h2>
  </div>
  <div class="signs">
    {%- for s in inicio.sinais %}
    <article class="sign"><span class="n">{{ loop.index }}</span><h3>{{ s.titulo }}</h3><p>{{ s.texto }}</p></article>
    {%- endfor %}
  </div>
</div></section>

<section><div class="wrap split">
  <div class="stack">
    <p class="ruled left">A abordagem</p>
    <h2>{{ inicio.abordagemTitulo }}</h2>
    {{ inicio.abordagemTexto | md | safe }}
    <ul class="checks">{% for d in inicio.destaques %}<li>{{ d }}</li>{% endfor %}</ul>
    <p><a href="/terapia/">Entenda como funciona a terapia</a></p>
  </div>
  <figure class="photo tall"><img src="/images/bruna-jeans.jpg" width="1179" height="1451" alt="Bruna Ribeiro falando para a câmera, com a mão no queixo, em seu consultório" loading="lazy"></figure>
</div></section>

<section class="sage quote-section"><div class="wrap">
  <p class="band">{{ inicio.frase | band | safe }}</p>
  <cite>{{ site.nome }}</cite>
  <a class="btn" href="{{ wa }}" target="_blank" rel="noopener">Quero começar</a>
</div></section>

<section><div class="wrap">
  <div class="stack">
    <p class="ruled left">Reflexões</p>
    <h2>Para ler com calma</h2>
  </div>
  <div class="reflections">
    {%- for r in collections.reflexoes %}{% if r.data.destaqueInicio %}
    <article class="reflection"><span class="tag">{{ r.data.categoria }}</span>
      <h3>{{ r.data.title }}</h3>
      <p>{{ r.data.resumo }}</p>
      <a href="{{ r.url }}">Continuar lendo</a></article>
    {%- endif %}{% endfor %}
  </div>
  <p style="margin-top:2rem"><a class="btn ghost" href="/reflexoes/">Todas as reflexões <span class="arrow" aria-hidden="true"></span></a></p>
</div></section>
